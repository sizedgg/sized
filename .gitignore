# ============================================================================
# Was NICHT in das oeffentliche Verzeichnis gehoert
#
# Zwei verschiedene Gruende, und sie sind nicht gleich wichtig:
#
#   Groesse    – node_modules und preview machen zusammen 200 MB. Beides ist
#                jederzeit neu erzeugbar, also gehoert es nicht in die
#                Versionsverwaltung.
#
#   Preisgabe  – alles, was das Projekt mit einer Person oder einem laufenden
#                Dienst verbindet. Diese Zeilen sind die wichtigen. Eine Datei,
#                die einmal eingecheckt war, bleibt im Verlauf stehen, auch
#                wenn man sie spaeter loescht.
# ============================================================================

# --- Groesse ---------------------------------------------------------------
node_modules/
preview/
*.tgz

# --- Preisgabe -------------------------------------------------------------
# Zugangsdaten in jeder Form. Im Quelltext steht nichts davon fest verdrahtet
# (nachgesehen, nicht angenommen) – diese Zeilen sind fuer das naechste Mal.
.env
.env.*
*.pem
*.key

# Der Arbeitsstand der Supabase-CLI. Enthaelt die Projektkennung, die
# Organisations-ID und die Pooler-Adresse – nichts davon ist ein Schluessel,
# aber alles davon ist internes Inventar und gehoert niemandem sonst.
supabase/.temp/

# Die echten Verbindungsdaten der Seite.
#
# Der anon-Key ist von Haus aus oeffentlich – er steht im Browser jedes
# Besuchers, sobald die Seite live ist, und jeder Zugriff laeuft ueber RLS.
# Trotzdem liegt er hier nicht im Verzeichnis: Vor dem Start gibt es keinen
# Grund, jemandem zu sagen, welches Projekt das ist. public/config.example.js
# traegt die Platzhalter, daraus wird die eigene Fassung.
public/config.js

# Die Startkonfiguration mit den echten Adressen.
#
# Treasury und Adminwallet stehen im Betrieb ohnehin offen da – die Treasury
# auf dem Anmeldebildschirm, die Adminwallet als Absender jeder Abstimmung.
# Hier geht es um etwas anderes: Eine Adresse in diesem Verzeichnis ist eine
# schriftliche Aussage darueber, WER hinter dem Projekt steht, und die wird
# vom Betreiber gemacht und nicht von einer Konfigurationsdatei.
#
# scripts/start-konfiguration.example.sql traegt die Platzhalter und die
# gesamte Begruendung; daraus wird die eigene Fassung.
scripts/start-konfiguration.sql

# Der Ordner, in dem geloeschte Sachen auf ihre Loeschung warten.
_to_delete/

# --- Werkzeuge, die hier nur zufaellig liegen ---------------------------------
# Die Supabase-CLI, heruntergeladen und entpackt. 107 MB Programmdatei, die
# jeder selbst holen kann und die mit dem Projekt nichts zu tun hat.
bin/
supabase.tar.gz

# Python legt neben jedem Skript kompilierten Bytecode ab. Eine .pyc-Datei im
# Verzeichnis ist das Erste, was auf GitHub schlampig aussieht – und sie stand
# hier nicht drin, ausgerechnet in der Datei, die erklaert, was nicht
# hineingehoert.
__pycache__/
*.pyc

# --- Nebenprodukte ---------------------------------------------------------
.DS_Store
*.log
.test-app-*.mjs
